{
  "name": "@ex-machina/db",
  "version": "0.0.0",
  "private": true,
  "description": "Database layer for ex-machina (MongoDB)",
  "type": "module",
  "main": "./src/index.ts",
  "exports": {
    ".": "./src/index.ts",
    "./client": "./src/client.ts",
    "./types": "./src/types.ts",
    "./agents": "./src/agents.ts",
    "./skills": "./src/skills.ts",
