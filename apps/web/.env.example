# Better Auth configuration
BETTER_AUTH_URL=http://localhost:3000
BETTER_AUTH_SECRET= # Generate: bunx --bun @better-auth/cli secret

# MongoDB configuration
MONGODB_URI=mongodb://localhost:27017/ex-machina
# DATABASE_URL also supported as fallback

# Google OAuth (Better Auth social provider)
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# GitHub App integration
# Setup URL: http://localhost:3000/api/integrations/github/setup
# Callback URL: http://localhost:3000/api/integrations/github/oauth/callback
GITHUB_APP_ID=
GITHUB_APP_CLIENT_ID=
GITHUB_APP_CLIENT_SECRET=
# PEM may be supplied on one line with escaped newlines.
GITHUB_APP_PRIVATE_KEY=
GITHUB_APP_SLUG=
# Dedicated 32+ byte key used to encrypt short-lived integration setup material.
INTEGRATION_ENCRYPTION_KEY=
# Optional overrides (default to github.com / api.github.com).
# GITHUB_API_BASE_URL=
# GITHUB_WEB_BASE_URL=

# Optional: set to skip env validation (e.g. Docker/CI builds without secrets).
# Never set at runtime.
# SKIP_ENV_VALIDATION=1
